/*云盘工具栏*/
QPushButton#cloudToolBarSideButton
{
	background-color: rgb(218, 218, 218);
	border: 0px;
}

QPushButton#cloudToolBarSideButton::hover,
QPushButton#cloudToolBarSideButton::pressed
{
	/*border: 1px solid rgb(124, 164, 249);*/
