GLayoutTabBar
{
	font-family: "microsoft yahei";
	font: 9pt;
}

GLayoutTabBar::tab
{
	min-height: 20px;
	margin-left: -3px;
	margin-right: -3px;
	padding-left: 5px;
}

GLayoutTabBar::tab:first
{
	margin-left: 0;
	padding-left: 0;
}
GLayoutTabBar::tab:last
{
	margin-right: 0;
}
GLayoutTabBar::tab:only-one
{
    margin: 0;
}
GLayoutTabBar::tab:!selected
{
	margin-top: 0px;
}

GLayoutTabBar QToolButton
{ /* the scroll buttons are tool buttons */
    background: lightgrey;
}

GLayoutTabBar::scroller
{ /* hide the scroll buttons */
    width: 0;
}

