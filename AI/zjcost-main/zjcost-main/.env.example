# ============================================================
#  筑衡 (zjcost) — 环境配置模板
#  复制为 .env 后按需修改，切勿将 .env 提交到版本库
# ============================================================

# ── 数据库 ──────────────────────────────────────────────
# 本地开发（SQLite，开箱即用）：
DATABASE_URL=sqlite:///./valuation.db
# 生产环境（PostgreSQL）：
# DATABASE_URL=postgresql://valuation:valuation@localhost:5432/valuation

# ── 数据目录 & 备份 ────────────────────────────────────
# 数据存储目录（数据库、上传文件都存这里），默认为 backend/ 目录
# 设为项目外路径可让升级代码不影响业务数据
ZJCOST_DATA_DIR=
# 自动备份保留份数（默认 10）
ZJCOST_MAX_BACKUPS=10
# 定期备份间隔（小时），0 = 仅启动时备份一次（默认）
# ZJCOST_BACKUP_INTERVAL_HOURS=4

# ── 服务器 / 安全 ───────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ZJCOST_AUTH_REQUIRED=false
ZJCOST_DEV_AUTH=true
JWT_SECRET_KEY=change-this-secret-before-deploying
JWT_EXPIRE_MINUTES=1440

# ── 上传限制 ────────────────────────────────────────────
MAX_UPLOAD_SIZE=104857600
DRAWING_MAX_UPLOAD_MB=100
IFC_MAX_UPLOAD_MB=150

# ── 广联达 IQCAD（可选）────────────────────────────────
GLADON_APPKEY=
GLADON_APPSECRET=
GLADON_API_TIMEOUT=300

# ── 辅助 Handler Provider ─────────────────────────────────
# 可选值: disabled | deepseek | qwen | kimi | glm | compatible
# 设为 disabled 时平台仍可正常运行，只是辅助功能不可用
ZH_PROVIDER=disabled
ZH_TIMEOUT_SECONDS=20
ZH_ENABLE_AUDIT_LOGS=false

# ── DeepSeek 配置 ────────────────────────────────────────
ZH_DEEPSEEK_API_KEY=
ZH_DEEPSEEK_BASE_URL=https://api.deepseek.com
ZH_DEEPSEEK_MODEL=deepseek-chat

# ── 通义千问 配置 ────────────────────────────────────────
ZH_QWEN_API_KEY=
ZH_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZH_QWEN_MODEL=qwen-plus

# ── Kimi 配置 ─────────────────────────────────────────────
ZH_KIMI_API_KEY=
ZH_KIMI_BASE_URL=https://api.moonshot.cn/v1
ZH_KIMI_MODEL=kimi-k2.5

# ── 智谱 GLM 配置 ────────────────────────────────────────
ZH_GLM_API_KEY=
ZH_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZH_GLM_MODEL=glm-4

# ── Compatible (ZjCost 兼容接口) 配置 ─────────────────────
ZH_MODEL_COMPAT_API_KEY=
ZH_MODEL_COMPAT_BASE_URL=https://api.compatible.com/v1
ZH_MODEL_COMPAT_MODEL=gpt-4o-mini

# ── 通用兜底（无对应 Provider 键时使用）────────────────
ZH_API_KEY=
ZH_BASE_URL=
ZH_MODEL=

# ── Embedding 后端 (Phase H5) ────────────────────────────
# "" (空) = 自动检测: 如有 MODEL_COMPAT_API_KEY 则用 compatible，否则用 hash
# "hash" = 强制离线 hash（免费，无外部调用）
# "compatible" = 强制 text-embedding-3-small（需要 API Key）
EMBEDDING_BACKEND=

# ModelCompat embedding（与上方辅助 chat Provider 独立）
MODEL_COMPAT_API_KEY=
# MODEL_COMPAT_BASE_URL=  # 可选，用于 Azure / 代理

# ── Memory 子系统 (Phase H7) ─────────────────────────────
ZH_AUTO_SAVE_MEMORY=false
ZH_MEMORY_EXTRACTOR_MAX_ITEMS=3